{
  "parallel-blocks": {
    "prefix": "parallel",
    "body": [
      "parallel {",
      "\t${1}",
      "} {",
      "\t${2}",
      "}"
    ],
    "description": "Parallel execution blocks"
  },
  "try-catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1}",
      "} catch {",
      "\t${2}",
      "}"
    ],
    "description": "Try/catch error handling"
  },
  "if-statement": {
    "prefix": "if",
    "body": [
      "if $${1:VAR} ${2:==} \"${3:val}\" {",
      "\t${4}",
      "}"
    ],
    "description": "If statement"
  },
  "if-else": {
    "prefix": "ife",
    "body": [
      "if $${1:VAR} ${2:==} \"${3:val}\" {",
      "\t${4}",
      "} else {",
      "\t${5}",
      "}"
    ],
    "description": "If/else statement"
  },
  "for-range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in [${2:1}..${3:10}] {",
      "\t${4}",
      "}"
    ],
    "description": "For-range loop"
  },
  "for-list": {
    "prefix": "forl",
    "body": [
      "for ${1:item} in [\"${2:a}\", \"${3:b}\", \"${4:c}\"] {",
      "\t${5}",
      "}"
    ],
    "description": "For-list loop"
  },
  "while-loop": {
    "prefix": "while",
    "body": [
      "while $${1:VAR} ${2:<} ${3:10} {",
      "\t${4}",
      "}"
    ],
    "description": "While loop"
  },
  "set-variable": {
    "prefix": "set",
    "body": [
      "set ${1:VAR} = \"${2:value}\""
    ],
    "description": "Set string variable"
  },
  "set-math": {
    "prefix": "setm",
    "body": [
      "set ${1:VAR} = ${2:0}"
    ],
    "description": "Set numeric variable"
  },
  "run-command": {
    "prefix": "run",
    "body": [
      "run \"${1:command}\""
    ],
    "description": "Run shell command"
  },
  "echo-message": {
    "prefix": "echo",
    "body": [
      "echo \"${1:message}\""
    ],
    "description": "Print message"
  }
}
