#!/usr/bin/env bash
# OC+ Runtime Cloud — Local CLI Runner
# Usage: ./scripts/ocp run <script.ocp> [--env KEY=VAL ...]

set -euo pipefail

API_URL="${OCP_API_URL:-http://localhost:8000}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# ── Colors ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
OC+ Runtime Cloud CLI

Usage:
  ocp run <script.ocp> [--env KEY=VALUE ...]   Run a script
  ocp health                                     Check API health
  ocp status <execution-id>                     Get execution status
  ocp version                                    Show version

Environment:
  OCP_API_URL    API server URL (default: http://localhost:8000)

Options:
  -t, --timeout SECONDS    Execution timeout (default: 300)
  --env KEY=VALUE          Inject environment variable

Examples:
  ocp run deploy.ocp
  ocp run backup.ocp --env DB_NAME=production
  ocp run deploy.ocp -t 600
  ocp health
EOF
}

health() {
    echo -e "${CYAN}Checking API health...${NC}"
    response=$(curl -sf "$API_URL/health" 2>&1) || {
        echo -e "${RED}API is not reachable at $API_URL${NC}"
        echo "Start the server: cd $REPO_ROOT && make run-api"
        exit 1
    }
    echo -e "${GREEN}$response${NC}"
}

execute() {
    local script_file="$1"
    shift
    local timeout=300
    local env_vars="{}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--timeout) timeout="$2"; shift 2 ;;
            --env)
                key="${2%%=*}"
                val="${2#*=}"
                env_vars=$(echo "$env_vars" | python3 -c "import sys,json; d=json.load(sys.stdin); d['$key']='$val'; print(json.dumps(d))")
                shift 2 ;;
            *) echo "Unknown option: $1"; usage; exit 1 ;;
        esac
    done

    if [[ ! -f "$script_file" ]]; then
        echo -e "${RED}Script not found: $script_file${NC}"
        exit 1
    fi

    local script_content
    script_content=$(cat "$script_file")

    echo -e "${CYAN}Executing: $script_file${NC}"
    echo -e "${YELLOW}Timeout: ${timeout}s${NC}"
    echo ""

    local payload
    payload=$(python3 -c "
import json, sys
print(json.dumps({
    'script': '''$script_content''',
    'timeout': $timeout,
    'env_vars': $env_vars
}))
")

    local response
    response=$(curl -sf -X POST "$API_URL/execute" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>&1) || {
        echo -e "${RED}Execution request failed${NC}"
        echo "$response"
        exit 1
    }

    # Parse and display
    echo "$response" | python3 -c "
import json, sys
r = json.load(sys.stdin)
status_color = '\033[0;32m' if r['status'] == 'success' else '\033[0;31m'
print(f\"ID:       {r['execution_id']}\")
print(f\"Status:   {status_color}{r['status']}\033[0m\")
print(f\"Duration: {r['duration_ms']}ms\")
print(f\"Time:     {r['created_at']}\")
print()
print('── STDOUT ──')
if r['stdout']:
    print(r['stdout'], end='')
else:
    print('(empty)')
if r['stderr']:
    print()
    print('── STDERR ──')
    print(r['stderr'], end='')
"
}

status() {
    local exec_id="$1"
    echo -e "${CYAN}Fetching execution: $exec_id${NC}"
    curl -sf "$API_URL/executions/$exec_id" | python3 -m json.tool
}

# ── Main ──

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

case "$1" in
    run)
        shift
        [[ $# -eq 0 ]] && { echo -e "${RED}Missing script file${NC}"; usage; exit 1; }
        execute "$@"
        ;;
    health)
        health
        ;;
    status)
        shift
        [[ $# -eq 0 ]] && { echo -e "${RED}Missing execution ID${NC}"; usage; exit 1; }
        status "$1"
        ;;
    version)
        echo "OC+ Runtime Cloud CLI v0.1.0"
        ;;
    *)
        usage
        exit 1
        ;;
esac
