# OC+ Runtime Cloud — Environment Variables
# Copy this file to .env and fill in your values

# API server URL (for CLI tool)
OCP_API_URL=http://localhost:8000

# Docker image tag for sandbox
OCP_SANDBOX_IMAGE=ocp-sandbox:latest

# API authentication (future)
# OCP_API_KEY=sk-xxxxxxxxxxxxx

# Database (future)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ocp_cloud

# Redis (future)
# REDIS_URL=redis://localhost:6379

# Telegram bot token (future)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh

# Email (SMTP) (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=xxxxxxxx
